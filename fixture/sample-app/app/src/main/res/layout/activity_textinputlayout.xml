<?xml version="1.0" encoding="utf-8"?>
<!--
  Single-widget fixture exercising
  com.google.android.material.textfield.TextInputLayout with an inner
  TextInputEditText. The implicit style picks up
  Widget.Material3.TextInputLayout.FilledBox via the Theme.Material3
  textInputFilledStyle attribute.

  Distinct gate paths from MaterialButton and Chip:
    * Drawable resolution routes through
      androidx.appcompat.widget.ResourceManagerInternal.loadDrawableFromDelegates
      (sibling .xml-suffix gate to com.android.layoutlib.bridge.impl
      .ResourceHelper.getDrawable that W4-B-C addressed).
    * ColorStateList resolution routes through
      androidx.core.content.ContextCompat.getColorStateList
      (sibling to com.android.layoutlib.bridge.impl
      .ResourceHelper.getColorStateList).
    * Two-widget inflation: TextInputLayout pulls in TextInputEditText
      via Material's per-widget materialThemeOverlay mechanism.
    * cursorColor + cursorErrorColor are API 31+ attributes whose
      layoutlib-14.0.11 handling is not yet exercised by activity_basic
      or activity_chip.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/text_input_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/fixture_text_input_hint"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/text_input_edit_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

    </com.google.android.material.textfield.TextInputLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
